# PostgreSQL connection string.
# Vercel Postgres (pooled) or Neon (pooled endpoint). Use sslmode=require.
# Example (Neon): postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional direct (non-pooled) connection string used for schema bootstrap.
# Leave empty to fall back to DATABASE_URL.
DIRECT_URL=

# Public base URL used to build short links. Leave empty to auto-detect the host from the request.
BASE_URL=

# Length of generated short codes (4-12).
SHORT_CODE_LENGTH=7

# Comma-separated allowed CORS origins. "*" allows all (the frontend is same-origin, so this is only for external clients).
CORS_ORIGINS=*

# Database pool sizing. Keep small on serverless so many function instances do not exhaust connections.
POOL_MIN_SIZE=1
POOL_MAX_SIZE=10

# Connection timeout (seconds) and retry settings for serverless cold starts.
DB_CONNECT_TIMEOUT=10
DB_RETRY_ATTEMPTS=3
DB_RETRY_BACKOFF=0.5

# Analytics settings.
MAX_REFERRER_LENGTH=500
DASHBOARD_TOP_LIMIT=10
CREATE_LINK_ATTEMPTS=5

# Enable verbose logging for local debugging.
DEBUG=false
